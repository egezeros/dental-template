# ─── Mode ──────────────────────────────────────────────────────────────────────
# Demo mode is ON unless set to false. In demo mode: fictional bookings are seeded,
# Telegram/WhatsApp work without keys (messages are simulated and shown in the
# admin "Notification log"), the admin password defaults to "demo".
DEMO_MODE=true

# Public URL of the deployment (used in Telegram links). Vercel's URL is used if empty.
NEXT_PUBLIC_SITE_URL=
# Shown in the footer: "This demo was prepared by <agency>".
NEXT_PUBLIC_AGENCY_NAME=
# Demo only: send every WhatsApp button (and demo patients' reminders) to YOUR number,
# international format without + (e.g. 994501234567), so you can try it on your phone.
DEMO_WHATSAPP_NUMBER=
# Hide the list of demo clinics on "/" (do this before sending links to clinics).
HIDE_DEMO_INDEX=false

# ─── Admin dashboard (/<slug>/admin) ───────────────────────────────────────────
# One password for all clinics, or per clinic with the slug in UPPER_SNAKE case.
ADMIN_PASSWORD=
# ADMIN_PASSWORD_DENT_STAR=
# ADMIN_PASSWORD_WHITE_ESTETIC_DENTAL=
# ADMIN_PASSWORD_DENTAL_CLUB=
# Optional extra secret mixed into session signatures.
ADMIN_SESSION_SECRET=

# ─── Storage ───────────────────────────────────────────────────────────────────
# supabase | sqlite | memory. Empty = auto: Supabase if configured, else memory on
# Vercel / in demo mode, else SQLite (local, persistent).
STORAGE_DRIVER=
SUPABASE_URL=
# Server-only key. Never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=
SQLITE_PATH=data/bookings.db
# Seed fictional demo bookings into Supabase too (default: only memory/SQLite).
DEMO_SEED_SUPABASE=false

# ─── Telegram staff notifications ──────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
# Default chat for all clinics, and/or one chat per clinic:
TELEGRAM_CHAT_ID=
# TELEGRAM_CHAT_ID_DENT_STAR=
# TELEGRAM_CHAT_ID_WHITE_ESTETIC_DENTAL=
# TELEGRAM_CHAT_ID_DENTAL_CLUB=
# Language of staff messages: az | ru | en
STAFF_LOCALE=az

# ─── Reminders (Vercel Cron → /api/cron/reminders, daily 18:00 Baku) ──────────
# Required outside demo mode. Vercel sends it as "Authorization: Bearer <secret>".
CRON_SECRET=
# wa-link (default: one-tap wa.me links for staff) | whatsapp-cloud (Meta API)
MESSAGING_PROVIDER=wa-link
WHATSAPP_CLOUD_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=appointment_reminder
WHATSAPP_API_VERSION=v21.0
